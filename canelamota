  <!-- Firebase SDKs -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
    import { getFirestore, doc, getDoc, setDoc, deleteDoc, collection, getDocs, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

    // =========================================================================
    // 1. CONFIGURACIÓN DE FIREBASE Y CUENTA ADMINISTRADORA GENERAL DEL ESPACIO
    // =========================================================================
    const FIREBASE_CONFIG = {
      apiKey: "TU_API_KEY",
      authDomain: "TU_PROYECTO.firebaseapp.com",
      projectId: "TU_PROYECTO",
      storageBucket: "TU_PROYECTO.appspot.com",
      messagingSenderId: "000000000000",
      appId: "1:000000000000:web:xxxxxxxxxxxx"
    };

    // Coloca aquí el correo de la Administradora General del espacio
    const GENERAL_ADMIN_EMAIL = "massiel2026@gmail.com";

    // Listado oficial de cursos del Centro Educativo en Artes Canela Mota
    const CURSOS = [
      { label: "1ro. A", code: "1A" },
      { label: "1ro. B", code: "1B" },
      { label: "2do. A", code: "2A" },
      { label: "2do. B", code: "2B" },
      { label: "3ro. A", code: "3A" },
      { label: "3ro. B", code: "3B" },
      { label: "3ro. C", code: "3C" },
      { label: "4to. Visuales", code: "4V" },
      { label: "4to. Música", code: "4M" },
      { label: "5to. Música", code: "5M" },
      { label: "5to. Visuales", code: "5V" },
      { label: "6to. Visuales", code: "6V" },
      { label: "6to. Música", code: "6M" }
    ];

    const app = initializeApp(FIREBASE_CONFIG);
    const auth = getAuth(app);
    const db = getFirestore(app);
    const provider = new GoogleAuthProvider();
    provider.setCustomParameters({ prompt: "select_account" });

    let currentUserRole = null;
    let allStudents = [];
    let parsedExcelRows = [];
    let staffViewPeriod = "P1";
    let activeStudent = null;
    let activeParentPeriod = "P1";
    let photoDataUrl = null;
    let mediaStream = null;

    function initCourseSelects() {
      const ids = ["excelCourseSelect", "viewCourseFilter", "studentCourseSelect", "filterStudentsCourse"];
      ids.forEach(selId => {
        const sel = document.getElementById(selId);
        if (!sel) return;
        sel.innerHTML = "";
        if (selId === "viewCourseFilter" || selId === "filterStudentsCourse") {
          const allOpt = document.createElement("option");
          allOpt.value = "ALL";
          allOpt.textContent = "Todos los cursos";
          sel.appendChild(allOpt);
        }
        CURSOS.forEach(c => {
          const opt = document.createElement("option");
          opt.value = c.label;
          opt.textContent = c.label;
          sel.appendChild(opt);
        });
      });
      suggestStudentId();
    }
    initCourseSelects();

    function showScreen(id) {
      document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
      document.getElementById(id).classList.add("active");
    }

    function isAuthorizedStaff(email) {
      if (!email) return false;
      const lower = email.toLowerCase().trim();
      if (lower === GENERAL_ADMIN_EMAIL.toLowerCase().trim()) return "admin";
      if (lower.endsWith("@docente.edu.do")) return "teacher";
      return false;
    }

    // --- INICIO DE SESIÓN GOOGLE (ADMINISTRADORA GENERAL Y DOCENTES) ---
    window.loginWithGoogle = async function() {
      const errBox = document.getElementById("parentLoginError");
      errBox.style.display = "none";
      try {
        const result = await signInWithPopup(auth, provider);
        const email = result.user.email;
        const role = isAuthorizedStaff(email);
        if (!role) {
          await signOut(auth);
          errBox.textContent = `Acceso denegado (${email}). Solo puede ingresar la Administradora General o docentes con correo @docente.edu.do.`;
          errBox.style.display = "block";
        }
      } catch (e) {
        errBox.textContent = "Error al iniciar sesión: " + e.message;
        errBox.style.display = "block";
      }
    };

    window.logoutUser = async function() {
      await signOut(auth);
      goHome();
    };

    onAuthStateChanged(auth, async (user) => {
      if (user) {
        const role = isAuthorizedStaff(user.email);
        if (role) {
          currentUserRole = role;
          document.getElementById("btnLogout").style.display = "inline-block";
          const roleBadge = document.getElementById("roleBadge");
          roleBadge.style.display = "inline-block";

          if (role === "admin") {
            roleBadge.textContent = "ADMINISTRADORA GENERAL";
            document.getElementById("panelTitle").textContent = "Panel de Administración General";
            document.getElementById("tabAdminBtn").style.display = "inline-block";
            document.getElementById("adminEmailDisplay").value = user.email;
          } else {
            roleBadge.textContent = "DOCENTE";
            document.getElementById("panelTitle").textContent = "Panel Docente";
            document.getElementById("tabAdminBtn").style.display = "none";
          }

          document.getElementById("staffEmailLabel").textContent = `${user.displayName || "Usuario"} (${user.email})`;
          showScreen("screen-staff");
          await loadAllStudents();
          return;
        }
      }
      currentUserRole = null;
      document.getElementById("btnLogout").style.display = "none";
      document.getElementById("roleBadge").style.display = "none";
    });

    function notifyStaff(msg, isError = false) {
      const ok = document.getElementById("staffMsgOk");
      const err = document.getElementById("staffMsgErr");
      ok.style.display = "none";
      err.style.display = "none";
      if (isError) {
        err.textContent = msg;
        err.style.display = "block";
      } else {
        ok.textContent = msg;
        ok.style.display = "block";
      }
    }

    window.switchTab = async function(tabName, btn) {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      ["excel", "view-grades", "students-ids", "admin-panel"].forEach(t => {
        document.getElementById("tab-" + t).style.display = t === tabName ? "block" : "none";
      });
      if (tabName === "view-grades") renderStaffGradesTable();
      if (tabName === "students-ids") renderStudentsList();
      if (tabName === "admin-panel") await loadDeliveriesAdmin();
    };

    // --- CARGA DE ESTUDIANTES Y GENERACIÓN / CAMBIO DE IDs POR CURSO ---
    async function loadAllStudents() {
      const snap = await getDocs(collection(db, "estudiantes"));
      allStudents = [];
      snap.forEach(d => allStudents.push({ id: d.id, ...d.data() }));
      allStudents.sort((a, b) => (a.course || "").localeCompare(b.course || "") || (a.name || "").localeCompare(b.name || ""));
      suggestStudentId();
      renderStudentsList();
      renderStaffGradesTable();
    }

    window.suggestStudentId = function() {
      const courseLabel = document.getElementById("studentCourseSelect").value;
      const courseObj = CURSOS.find(c => c.label === courseLabel) || CURSOS[0];
      const countInCourse = allStudents.filter(s => s.course === courseLabel).length + 1;
      const numStr = String(countInCourse).padStart(3, "0");
      document.getElementById("studentCustomId").value = `CM-${courseObj.code}-${numStr}`;
    };

    window.saveOrUpdateStudent = async function() {
      const course = document.getElementById("studentCourseSelect").value;
      const name = document.getElementById("studentFullName").value.trim().toUpperCase();
      const newId = document.getElementById("studentCustomId").value.trim().toUpperCase();

      if (!name || !newId) {
        notifyStaff("Complete el nombre del estudiante y el ID.", true);
        return;
      }

      try {
        await setDoc(doc(db, "estudiantes", newId), {
          name,
          course,
          periods: { P1: {}, P2: {}, P3: {}, P4: {} },
          updatedBy: auth.currentUser.email,
          updatedAt: serverTimestamp()
        }, { merge: true });

        document.getElementById("studentFullName").value = "";
        notifyStaff(`Estudiante ${name} guardado en ${course} con el ID: ${newId}`);
        await loadAllStudents();
      } catch (e) {
        notifyStaff("Error al guardar estudiante: " + e.message, true);
      }
    };

    window.changeStudentId = async function(oldId) {
      const student = allStudents.find(s => s.id === oldId);
      if (!student) return;
      const proposed = prompt(`Cambiar ID para ${student.name} (${student.course}):`, oldId);
      if (!proposed) return;
      const cleanNewId = proposed.trim().toUpperCase();
      if (cleanNewId === oldId) return;

      if (allStudents.some(s => s.id === cleanNewId)) {
        notifyStaff(`El ID ${cleanNewId} ya está en uso por otro estudiante.`, true);
        return;
      }

      try {
        const { id, ...rest } = student;
        await setDoc(doc(db, "estudiantes", cleanNewId), {
          ...rest,
          updatedBy: auth.currentUser.email,
          updatedAt: serverTimestamp()
        });
        await deleteDoc(doc(db, "estudiantes", oldId));
        notifyStaff(`ID actualizado de ${oldId} a ${cleanNewId}.`);
        await loadAllStudents();
      } catch (e) {
        notifyStaff("Error al cambiar ID: " + e.message, true);
      }
    };

    window.regenerateCourseIds = async function() {
      const selectedCourse = document.getElementById("filterStudentsCourse").value;
      if (selectedCourse === "ALL") {
        notifyStaff("Seleccione un curso específico en el filtro para regenerar sus IDs.", true);
        return;
      }
      const courseObj = CURSOS.find(c => c.label === selectedCourse);
      const list = allStudents.filter(s => s.course === selectedCourse);
      if (list.length === 0) {
        notifyStaff("No hay estudiantes registrados en ese curso.", true);
        return;
      }

      const suffix = Math.floor(10 + Math.random() * 89);
      try {
        let idx = 1;
        for (const st of list) {
          const newId = `CM-${courseObj.code}-${suffix}${String(idx).padStart(2, "0")}`;
          const { id, ...rest } = st;
          await setDoc(doc(db, "estudiantes", newId), rest);
          if (st.id !== newId) await deleteDoc(doc(db, "estudiantes", st.id));
          idx++;
        }
        notifyStaff(`Se regeneraron ${list.length} IDs para el curso ${selectedCourse}.`);
        await loadAllStudents();
      } catch (e) {
        notifyStaff("Error al regenerar IDs: " + e.message, true);
      }
    };

    window.renderStudentsList = function() {
      const filter = document.getElementById("filterStudentsCourse").value;
      const table = document.getElementById("studentsListTable");
      const filtered = filter === "ALL" ? allStudents : allStudents.filter(s => s.course === filter);

      if (filtered.length === 0) {
        table.innerHTML = "<tr><td style='padding:14px; color:#64748b;'>No hay estudiantes registrados en este filtro.</td></tr>";
        return;
      }

      let html = `
        <thead>
          <tr>
            <th>Curso</th>
            <th>Estudiante</th>
            <th>ID de Acceso Padres</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
      `;
      filtered.forEach(s => {
        html += `
          <tr>
            <td><strong>${s.course}</strong></td>
            <td>${s.name}</td>
            <td><span class="id-badge">${s.id}</span></td>
            <td><button type="button" class="btn-secondary" style="padding:5px 10px; font-size:12px;" onclick="changeStudentId('${s.id}')">Cambiar ID</button></td>
          </tr>
        `;
      });
      html += "</tbody>";
      table.innerHTML = html;
    };

    // --- IMPORTACIÓN Y EXPORTACIÓN DE EXCEL (SHEETJS) ---
    window.downloadExcelTemplate = function() {
      const course = document.getElementById("excelCourseSelect").value;
      const subject = document.getElementById("excelDefaultSubject").value.trim() || "Artes Visuales / Asignatura";
      const studentsInCourse = allStudents.filter(s => s.course === course);

      const rows = studentsInCourse.length > 0
        ? studentsInCourse.map(s => ({
            ID: s.id,
            Estudiante: s.name,
            Curso: s.course,
            Asignatura: subject,
            Comunicativa: 90,
            Pensamiento_Logico: 88,
            Cientifica: 89,
            Etica: 92
          }))
        : [
            {
              ID: `CM-${(CURSOS.find(c => c.label === course) || CURSOS[0]).code}-001`,
              Estudiante: "EJEMPLO, ESTUDIANTE UNO",
              Curso: course,
              Asignatura: subject,
              Comunicativa: 90,
              Pensamiento_Logico: 88,
              Cientifica: 89,
              Etica: 92
            }
          ];

      const ws = XLSX.utils.json_to_sheet(rows);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, "Calificaciones");
      XLSX.writeFile(wb, `Plantilla_${course.replace(/[^a-zA-Z0-9]/g, "_")}.xlsx`);
    };

    window.handleExcelUpload = function(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const data = new Uint8Array(e.target.result);
        const workbook = XLSX.read(data, { type: "array" });
        const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
        const json = XLSX.utils.sheet_to_json(firstSheet, { defval: "" });

        const selectedCourse = document.getElementById("excelCourseSelect").value;
        const defaultSubject = document.getElementById("excelDefaultSubject").value.trim() || "Asignatura General";
        const courseObj = CURSOS.find(c => c.label === selectedCourse) || CURSOS[0];

        parsedExcelRows = json.map((row, idx) => {
          const rawId = String(row.ID || row.Id || row.id || "").trim().toUpperCase();
          const name = String(row.Estudiante || row.Nombre || row.estudiante || "").trim().toUpperCase();
          const subject = String(row.Asignatura || row.Materia || defaultSubject).trim();
          const c1 = Number(row.Comunicativa ?? row.Nota ?? 0);
          const c2 = Number(row.Pensamiento_Logico ?? row["Pensamiento Logico"] ?? row.Nota ?? 0);
          const c3 = Number(row.Cientifica ?? row.Nota ?? 0);
          const c4 = Number(row.Etica ?? row.Nota ?? 0);

          let finalId = rawId;
          if (!finalId) {
            const existing = allStudents.find(s => s.course === selectedCourse && s.name === name);
            finalId = existing ? existing.id : `CM-${courseObj.code}-${String(allStudents.length + idx + 1).padStart(3, "0")}`;
          }

          return { id: finalId, name, course: selectedCourse, subject, c1, c2, c3, c4 };
        }).filter(r => r.name);

        if (parsedExcelRows.length === 0) {
          notifyStaff("No se encontraron filas válidas con columna 'Estudiante' en el archivo Excel.", true);
          return;
        }

        const previewTable = document.getElementById("excelPreviewTable");
        let html = `
          <thead>
            <tr>
              <th>ID</th>
              <th>Estudiante</th>
              <th>Asignatura</th>
              <th>Com.</th>
              <th>Pens. Lóg.</th>
              <th>Cient.</th>
              <th>Ética</th>
              <th>Prom.</th>
            </tr>
          </thead>
          <tbody>
        `;
        parsedExcelRows.forEach(r => {
          const avg = Math.round((r.c1 + r.c2 + r.c3 + r.c4) / 4);
          html += `
            <tr>
              <td><span class="id-badge">${r.id}</span></td>
              <td>${r.name}</td>
              <td>${r.subject}</td>
              <td>${r.c1}</td>
              <td>${r.c2}</td>
              <td>${r.c3}</td>
              <td>${r.c4}</td>
              <td><strong>${avg}</strong></td>
            </tr>
          `;
        });
        html += "</tbody>";
        previewTable.innerHTML = html;
        document.getElementById("excelPreviewContainer").style.display = "block";
      };
      reader.readAsArrayBuffer(file);
    };

    window.publishExcelGrades = async function() {
      const period = document.getElementById("excelPeriodSelect").value;
      if (parsedExcelRows.length === 0) return;

      try {
        for (const r of parsedExcelRows) {
          const ref = doc(db, "estudiantes", r.id);
          const snap = await getDoc(ref);
          const currentPeriods = snap.exists() ? (snap.data().periods || {}) : {};
          const periodSubjects = currentPeriods[period] || {};

          periodSubjects[r.subject] = {
            Comunicativa: r.c1,
            "Pensamiento Lógico": r.c2,
            "Científica y Tecnológica": r.c3,
            "Ética y Ciudadana": r.c4,
            updatedBy: auth.currentUser.email
          };

          currentPeriods[period] = periodSubjects;

          await setDoc(ref, {
            name: r.name,
            course: r.course,
            periods: currentPeriods,
            updatedAt: serverTimestamp()
          }, { merge: true });
        }

        notifyStaff(`¡Listo! Se publicaron ${parsedExcelRows.length} registros en ${period}.`);
        parsedExcelRows = [];
        document.getElementById("excelPreviewContainer").style.display = "none";
        document.getElementById("excelFileInput").value = "";
        await loadAllStudents();
      } catch (e) {
        notifyStaff("Error al publicar calificaciones desde Excel: " + e.message, true);
      }
    };

    // --- VISUALIZACIÓN DE NOTAS P1-P4 EN PANEL DOCENTE ---
    window.setStaffPeriod = function(p, btn) {
      staffViewPeriod = p;
      document.querySelectorAll("#tab-view-grades .period-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderStaffGradesTable();
    };

    window.renderStaffGradesTable = function() {
      const courseFilter = document.getElementById("viewCourseFilter").value;
      const table = document.getElementById("staffGradesTable");
      const list = courseFilter === "ALL" ? allStudents : allStudents.filter(s => s.course === courseFilter);

      let html = `
        <thead>
          <tr>
            <th>ID</th>
            <th>Curso</th>
            <th>Estudiante</th>
            <th>Asignaturas y Promedios (${staffViewPeriod})</th>
          </tr>
        </thead>
        <tbody>
      `;

      let count = 0;
      list.forEach(st => {
        const pData = (st.periods && st.periods[staffViewPeriod]) || {};
        const subjects = Object.keys(pData);
        count++;
        const badges = subjects.length > 0
          ? subjects.map(sub => {
              const c = pData[sub];
              const avg = Math.round(((c.Comunicativa || 0) + (c["Pensamiento Lógico"] || 0) + (c["Científica y Tecnológica"] || 0) + (c["Ética y Ciudadana"] || 0)) / 4);
              return `<span class="id-badge" style="margin:2px;">${sub}: ${avg}</span>`;
            }).join(" ")
          : `<span style="color:#64748b; font-size:12px;">Sin notas en ${staffViewPeriod}</span>`;

        html += `
          <tr>
            <td><span class="id-badge">${st.id}</span></td>
            <td>${st.course}</td>
            <td><strong>${st.name}</strong></td>
            <td>${badges}</td>
          </tr>
        `;
      });

      if (count === 0) {
        html = "<tr><td style='padding:14px; color:#64748b;'>No hay estudiantes en este curso.</td></tr>";
      } else {
        html += "</tbody>";
      }
      table.innerHTML = html;
    };

    // --- PANEL ADMINISTRADORA GENERAL ---
    window.authorizeTeacher = async function() {
      const email = document.getElementById("newTeacherEmail").value.trim().toLowerCase();
      if (!email.endsWith("@docente.edu.do")) {
        notifyStaff("El correo debe terminar en @docente.edu.do", true);
        return;
      }
      await setDoc(doc(db, "docentes_autorizados", email), {
        email,
        authorizedBy: auth.currentUser.email,
        createdAt: serverTimestamp()
      });
      document.getElementById("newTeacherEmail").value = "";
      notifyStaff(`Docente ${email} registrado correctamente.`);
    };

    async function loadDeliveriesAdmin() {
      const table = document.getElementById("deliveriesTable");
      const snap = await getDocs(collection(db, "entregas"));
      if (snap.empty) {
        table.innerHTML = "<tr><td style='padding:14px; color:#64748b;'>Aún no hay constancias de entrega registradas por padres.</td></tr>";
        return;
      }
      let html = `
        <thead>
          <tr>
            <th>ID Estudiante</th>
            <th>Estudiante</th>
            <th>Curso</th>
            <th>Recibido por</th>
            <th>Constancia</th>
          </tr>
        </thead>
        <tbody>
      `;
      snap.forEach(d => {
        const item = d.data();
        html += `
          <tr>
            <td><span class="id-badge">${item.studentId}</span></td>
            <td>${item.studentName || ""}</td>
            <td>${item.course || ""}</td>
            <td><strong>${item.guardianName}</strong> (${item.relation})</td>
            <td>${item.photoThumbnail ? `<img src="${item.photoThumbnail}" style="width:48px; height:48px; border-radius:8px; object-fit:cover;" />` : "-"}</td>
          </tr>
        `;
      });
      html += "</tbody>";
      table.innerHTML = html;
    }

    // --- FLUJO DE PADRES CON ID DEL ESTUDIANTE ---
    window.parentLogin = async function() {
      const rawId = document.getElementById("parentStudentId").value.trim().toUpperCase();
      const err = document.getElementById("parentLoginError");
      err.style.display = "none";

      if (!rawId) {
        err.textContent = "Por favor, ingrese el ID del estudiante.";
        err.style.display = "block";
        return;
      }

      try {
        const snap = await getDoc(doc(db, "estudiantes", rawId));
        if (!snap.exists()) {
          err.textContent = "No se encontró ningún estudiante con ese ID. Verifique con la administración del centro.";
          err.style.display = "block";
          return;
        }
        activeStudent = { id: rawId, ...snap.data() };
        document.getElementById("confirmStudentLabel").textContent = `${activeStudent.name} (${activeStudent.course})`;
        showScreen("screen-parent-confirm");
      } catch (e) {
        err.textContent = "Error al consultar el ID: " + e.message;
        err.style.display = "block";
      }
    };

    window.startCamera = async function() {
      const video = document.getElementById("videoFeed");
      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" }, audio: false });
        video.srcObject = mediaStream;
        video.style.display = "block";
        document.getElementById("capturedPhoto").style.display = "none";
        document.getElementById("cameraPlaceholder").style.display = "none";
        document.getElementById("btnCapture").style.display = "inline-block";
      } catch {
        alert("No se pudo abrir la cámara. Puede usar el botón 'Subir foto'.");
      }
    };

    window.capturePhoto = function() {
      const video = document.getElementById("videoFeed");
      const canvas = document.getElementById("photoCanvas");
      const img = document.getElementById("capturedPhoto");

      canvas.width = 320;
      canvas.height = 240;
      canvas.getContext("2d").drawImage(video, 0, 0, canvas.width, canvas.height);
      photoDataUrl = canvas.toDataURL("image/jpeg", 0.6);

      img.src = photoDataUrl;
      img.style.display = "block";
      video.style.display = "none";
      document.getElementById("btnCapture").style.display = "none";
      stopCamera();
    };

    window.handleFilePhoto = function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const tempImg = new Image();
        tempImg.onload = () => {
          const canvas = document.getElementById("photoCanvas");
          canvas.width = 320;
          canvas.height = 240;
          canvas.getContext("2d").drawImage(tempImg, 0, 0, 320, 240);
          photoDataUrl = canvas.toDataURL("image/jpeg", 0.6);

          const img = document.getElementById("capturedPhoto");
          img.src = photoDataUrl;
          img.style.display = "block";
          document.getElementById("cameraPlaceholder").style.display = "none";
          stopCamera();
        };
        tempImg.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    };

    function stopCamera() {
      if (mediaStream) {
        mediaStream.getTracks().forEach(t => t.stop());
        mediaStream = null;
      }
    }

    window.submitDeliveryAndShowGrades = async function() {
      const guardianName = document.getElementById("guardianName").value.trim();
      const relation = document.getElementById("guardianRelation").value;
      const err = document.getElementById("confirmError");

      if (!guardianName || !relation || !photoDataUrl) {
        err.textContent = "Complete su nombre, parentesco y tome o suba una foto de constancia.";
        err.style.display = "block";
        return;
      }
      err.style.display = "none";

      await addDoc(collection(db, "entregas"), {
        studentId: activeStudent.id,
        studentName: activeStudent.name,
        course: activeStudent.course,
        guardianName,
        relation,
        photoThumbnail: photoDataUrl,
        timestamp: serverTimestamp()
      });

      document.getElementById("viewStudentName").textContent = activeStudent.name;
      document.getElementById("viewStudentMeta").textContent =
        `Curso: ${activeStudent.course} · ID: ${activeStudent.id} · Recibe: ${guardianName} (${relation})`;

      activeParentPeriod = "P1";
      renderParentGrades();
      showScreen("screen-parent-grades");
    };

    window.selectParentPeriod = function(period, btn) {
      activeParentPeriod = period;
      document.querySelectorAll("#screen-parent-grades .period-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderParentGrades();
    };

    function renderParentGrades() {
      const list = document.getElementById("parentSubjectsList");
      const periodData = (activeStudent.periods && activeStudent.periods[activeParentPeriod]) || {};
      const subjects = Object.keys(periodData);

      if (subjects.length === 0) {
        list.innerHTML = `<p style="font-size:13px; color:#64748b; text-align:center; padding:24px;">Aún no hay calificaciones publicadas para el periodo ${activeParentPeriod}.</p>`;
        return;
      }

      list.innerHTML = "";
      subjects.forEach(subj => {
        const comp = periodData[subj];
        const scores = ["Comunicativa", "Pensamiento Lógico", "Científica y Tecnológica", "Ética y Ciudadana"]
          .map(k => Number(comp[k] || 0));
        const avg = Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);

        const card = document.createElement("div");
        card.className = "subject-card";
        card.innerHTML = `
          <div class="subject-header">
            <span>${subj}</span>
            <span class="avg-pill">Promedio ${activeParentPeriod}: ${avg}</span>
          </div>
          <div class="comp-grid">
            <div>Comunicativa: <strong>${comp["Comunicativa"] ?? "-"}</strong></div>
            <div>Pens. Lógico: <strong>${comp["Pensamiento Lógico"] ?? "-"}</strong></div>
            <div>Científica: <strong>${comp["Científica y Tecnológica"] ?? "-"}</strong></div>
            <div>Ética y Ciud.: <strong>${comp["Ética y Ciudadana"] ?? "-"}</strong></div>
          </div>
        `;
        list.appendChild(card);
      });
    }

    window.goHome = function() {
      stopCamera();
      photoDataUrl = null;
      showScreen("screen-home");
    };
  </script>
</body>
</html>
